<Window x:Class="WPF.Common.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông báo" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceColor" Color="#ffffff"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0052ff"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6b7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#e5e7eb"/>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="20" Padding="28,24" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.15" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Close Button Top Right -->
            <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" 
                    FontSize="18" Cursor="Hand" Click="CancelButton_Click" Margin="0,-4,-4,0"/>

            <!-- Icon Header & Title -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <Border x:Name="IconBadge" Width="48" Height="48" CornerRadius="24" Background="#FEF2F2" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IconText" Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock" Text="Tiêu đề thông báo" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubtitleTextBlock" Text="Thông báo hệ thống" FontSize="12" Foreground="{StaticResource TextSecondary}" Visibility="Collapsed" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Message Body -->
            <TextBlock x:Name="MessageTextBlock" Grid.Row="2" FontSize="14" Foreground="#374151" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

            <!-- Optional SubMessage Highlight Box -->
            <Border x:Name="HighlightBorder" Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="HighlightTextBlock" FontSize="13" Foreground="#4B5563" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelBtn" Grid.Column="0" Content="Hủy bỏ" Height="42" 
                        Background="#F3F4F6" Foreground="#4B5563" FontWeight="SemiBold" 
                        BorderThickness="0" Cursor="Hand" Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="ConfirmBtn" Grid.Column="2" Content="Xác nhận" Height="42" 
                        Background="#DC2626" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand" Click="ConfirmButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
